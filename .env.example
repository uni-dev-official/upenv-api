# Public Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=

# Supabase publishable/anon key. Do NOT put the service_role key here.
SUPABASE_ANON_KEY=

# API bind address
HOST=0.0.0.0
PORT=8080

# Optional: frontend origin(s), comma-separated.
# Example: https://upenv.dev,http://localhost:1420
CORS_ORIGINS=http://localhost:1420
